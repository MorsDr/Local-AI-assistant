{
  "sources": {
    "official": [
      "python.org",
      "pytorch.org",
      "tensorflow.org",
      "openai.com"
    ],
    "docs": [
      "docs.python.org",
      "developer.mozilla.org"
    ],
    "trusted": [
      "wikipedia.org",
      "github.com",
      "stackoverflow.com"
    ],
    "community": [
      "reddit.com",
      "medium.com"
    ]
  },
  "trust_scores": {
    "official": 1.2,
    "docs": 1.1,
    "trusted": 1.0,
    "community": 0.8,
    "other": 0.6
  },
  "limits": {
    "max_links": 10,
    "agents": 5
  },
  "headers_template":{
    "Accept":"text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7",
    "Accept-Language": "ru-RU,ru;q=0.9,en-US;q=0.8,en;q=0.7",
    "Accept-Encoding": "gzip, deflate, br",
    "DNT": "1",
    "Connection": "keep-alive",
    "Upgrade-Insecure-Requests": "1",
    "Sec-Fetch-Dest": "document",
    "Sec-Fetch-Mode": "navigate",
    "Sec-Feth-Site": "none",
    "Sec-Feth-User": "?1",
  },
  "ranking_weights":{
    "trust_bonus":2.0,
    "recency_weight":1.5,
    "tag_match_weight":1.0,
    "type_weights":{
      "article":1.0,
      "video":0.6,
      "short_video":0.3,
      "social":0.4
    },
    "threshold":1.2
  },
  "block_markers":[
   "captcha",
   "cloudflare",
   "ddos-protection",
   "robot check",
   "access denied",
   "challenge-running",
   "forbidden",
   "подтвердите, что вы не робот",
   "проверка безопасности"
  ],
  "special_treatment":[
   "youtube.com", "youtu.be",
   "tiktok.com",
   "instagram.com",
   "facebook.com",
   "vimeo.com",
   "rutube.ru",
   "skipvids.com",
   "hd2k.ru",
   "vk.com", "vk.ru"
  ]
}
