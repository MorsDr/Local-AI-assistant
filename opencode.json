      "name": "llama.cpp — Qwen Coder 14B",

      "package": "@opencode/ai/providers/openai-compatible",

      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },

      "models": {
        "qwen-coder-14b": {
          "modelID": "qwen_code(2.5\\14B\\q5KM\\10GB)",

          "capabilities": {
